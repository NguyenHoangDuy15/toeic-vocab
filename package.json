{
  "name": "toeic-vocab",
  "private": true,
  "version": "0.1.0",
  "description": "TOEIC 800+ vocabulary coach following Hackers TOEIC Vocabulary",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w apps/api",
    "db:seed": "npm run seed -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm test -w apps/api",
    "build": "npm run build -w apps/api && npm run build -w apps/web"
  }
}

